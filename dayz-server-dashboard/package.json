    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.321.0",
    "node-cron": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
